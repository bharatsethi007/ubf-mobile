{
  "expo": {
    "name": "Conferences",
    "slug": "ubf-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ubfmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#012652",
        "foregroundImage": "./assets/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ubfreight.ubfmobile"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#012652",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UBF uses your photos to attach them to agent meetings.",
          "cameraPermission": "UBF uses the camera to photograph business cards and meeting moments."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "UBF uses the microphone to record and transcribe agent meetings."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef7bfab4-f92b-40b4-9e6f-4711493749ee"
      }
    }
  }
}